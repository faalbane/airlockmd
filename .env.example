# Copy to .env.local and fill in. Never commit .env or a debug token.
# The web config is not a server secret, but keep real project values out of git.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# reCAPTCHA Enterprise site key (or a v3 site key if VITE_RECAPTCHA_PROVIDER=v3)
VITE_RECAPTCHA_SITE_KEY=
VITE_RECAPTCHA_PROVIDER=enterprise

# Local and judge testing only. true prints a new token in the console.
# Or paste a token you already registered in App Check. Never commit it.
VITE_APPCHECK_DEBUG_TOKEN=
